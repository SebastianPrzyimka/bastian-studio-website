---
import { site } from '../data/site';
import { waIcon, phoneIcon } from './Icons';
interface Props { hasContact?: boolean }
const { hasContact = true } = Astro.props;
---
<div class="actionbar" role="region" aria-label="Quick contact">
  <a href={site.phoneHref} class="btn btn-ghost" aria-label="Call" style="min-height: 48px; padding: 0; font-size: 15px" set:html={phoneIcon}></a>
  <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-ghost" style="min-height: 48px; padding: 0 12px; font-size: 15px"><Fragment set:html={waIcon} />WhatsApp<span class="sr-only"> (opens in a new tab)</span></a>
  <a href={hasContact ? '#contact' : '/#contact'} class="btn btn-ice" style="min-height: 48px; font-size: 15px">Get a quote</a>
</div>
