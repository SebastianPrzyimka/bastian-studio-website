---
import BaseLayout from '../layouts/BaseLayout.astro';

---
<BaseLayout title="Page not found | Bastian Studio" description="Sorry, this page doesn’t exist. Find web design, SEO and Google Ads services from Bastian Studio, Glasgow." hasContact={false} noindex>
<section id="top" class="hero-pad" style="position: relative; padding: 96px 0 112px; background: radial-gradient(900px 460px at 80% 0%, rgba(62,143,208,.22), transparent 70%), #0A1020">
  <div class="wrap split" style="align-items: center">
    <div class="split-a7">
      <p aria-hidden="true" style="margin: 0; font-size: clamp(96px, 16vw, 220px); font-weight: 500; line-height: .85; letter-spacing: -.06em; color: rgba(159,211,245,.18)">404</p>
      <h1 style="margin: 20px 0 0; font-size: clamp(36px, 4.6vw, 64px); font-weight: 500; line-height: 1.02; letter-spacing: -.045em">This page has gone <span class="serif" style="color: #9FD3F5">walkabout.</span></h1>
      <p style="margin: 22px 0 32px; font-size: 18px; line-height: 1.6; color: #B7C3D4; max-width: 46ch">The link may be old or mistyped. Let’s get you back on track, or just get in touch and I’ll help.</p>
      <div style="display: flex; flex-wrap: wrap; gap: 12px">
        <a href="/" class="btn btn-ice">Back to home</a>
        <a href="/prices" class="btn btn-ghost">See prices</a>
      </div>
    </div>
    <div class="split-b5">
      <p class="mono" style="margin: 0 0 8px; color: #9AA8BC">Popular pages</p>
      <ul style="list-style: none; margin: 0; padding: 0; border-bottom: 1px solid rgba(159,211,245,.14)"><li><a href="/#services" style="display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-top: 1px solid rgba(159,211,245,.14); color: #EEF4FA; text-decoration: none; font-size: 18px; min-height: 44px">Services<span style="color: #9FD3F5">→</span></a></li><li><a href="/prices" style="display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-top: 1px solid rgba(159,211,245,.14); color: #EEF4FA; text-decoration: none; font-size: 18px; min-height: 44px">Prices<span style="color: #9FD3F5">→</span></a></li><li><a href="/about" style="display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-top: 1px solid rgba(159,211,245,.14); color: #EEF4FA; text-decoration: none; font-size: 18px; min-height: 44px">About<span style="color: #9FD3F5">→</span></a></li><li><a href="/guides" style="display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-top: 1px solid rgba(159,211,245,.14); color: #EEF4FA; text-decoration: none; font-size: 18px; min-height: 44px">Guides<span style="color: #9FD3F5">→</span></a></li><li><a href="/#contact" style="display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-top: 1px solid rgba(159,211,245,.14); color: #EEF4FA; text-decoration: none; font-size: 18px; min-height: 44px">Contact<span style="color: #9FD3F5">→</span></a></li></ul>
    </div>
  </div>
</section>
</BaseLayout>
