---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';
---
<BaseLayout title="Guides for Small Businesses | Websites, SEO & Google | Bastian Studio" description="Plain-English guides on website costs, SEO, Google Ads and getting more customers online. No jargon, no sales pitch.">
<section id="top" class="hero-pad" style="position: relative; padding: 80px 0 88px; background: radial-gradient(900px 460px at 80% 0%, rgba(62,143,208,.22), transparent 70%), #0A1020">
  <div class="wrap">
    <p class="mono" style="margin: 0 0 20px; color: #9FD3F5"><a href="/" style="color: #9AA8BC; text-decoration: none">Home</a> / Guides</p>
    <h1 style="margin: 0; font-size: clamp(40px, 5.4vw, 76px); font-weight: 500; line-height: 1; letter-spacing: -.045em; max-width: 18ch">Straight-talking guides for <span class="serif" style="color: #9FD3F5">local businesses.</span></h1>
    <p style="margin: 24px 0 32px; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.55; color: #B7C3D4; max-width: 54ch">Plain-English answers about websites, Google and getting more customers. No jargon, no sales pitch.</p>
  </div>
</section>

<section class="sec" style="padding: 40px 0 112px">
  <div class="wrap" style="border-top: 1px solid rgba(159,211,245,.16)">
    <a href="/guides/website-cost-scotland" class="guide-row" style="text-decoration: none; color: #EEF4FA">
          <span style="display: flex; flex-direction: column; gap: 6px"><span style="font-size: clamp(20px, 2vw, 26px); font-weight: 500; letter-spacing: -.02em">How much does a website cost in Scotland in 2026?</span><span style="color: #9AA8BC; font-size: 16px">Typical UK prices by size, what changes the price and what you’ll pay each month.</span></span>
          <span class="mono" style="color: #9FD3F5; white-space: nowrap">6 min read →</span>
        </a><div class="guide-row" style="opacity: .6">
          <span style="display: flex; flex-direction: column; gap: 6px"><span style="font-size: clamp(20px, 2vw, 26px); font-weight: 500; letter-spacing: -.02em">SEO vs Google Ads for local businesses</span><span style="color: #9AA8BC; font-size: 16px">Which one to start with, what each costs and when you’ll see results.</span></span>
          <span class="mono" style="color: #9AA8BC; white-space: nowrap">Coming soon</span>
        </div><div class="guide-row" style="opacity: .6">
          <span style="display: flex; flex-direction: column; gap: 6px"><span style="font-size: clamp(20px, 2vw, 26px); font-weight: 500; letter-spacing: -.02em">What to put on a salon website</span><span style="color: #9AA8BC; font-size: 16px">The pages and features that turn visitors into bookings.</span></span>
          <span class="mono" style="color: #9AA8BC; white-space: nowrap">Coming soon</span>
        </div>
  </div>
</section>

<ContactSection />

</BaseLayout>
