---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import { diy, priceRanges, packages } from '../data/prices';
const MAX = 15000;
const pct = (v: number) => (Math.min(v, MAX) / MAX * 100).toFixed(2) + '%';
const gbp = (v: number) => '£' + v.toLocaleString('en-GB');
const ranges = priceRanges.map((r: any) => ({ ...r,
  text: r.text || (gbp(r.lo) + '–' + gbp(r.hi) + (r.plus ? '+' : '')),
  left: pct(r.lo),
  width: Math.max((Math.min(r.hi, MAX) - r.lo) / MAX * 100, 1.5).toFixed(2) + '%' }));
const packs = packages.map((p: any) => p.popular
  ? { ...p, bg: '#0A1020', fg: '#EEF4FA', border: '#0A1020', tick: '#9FD3F5', btnBg: '#9FD3F5', btnFg: '#0A1020' }
  : { ...p, bg: '#FFFFFF', fg: '#0A1020', border: 'rgba(10,16,32,.1)', tick: '#1F6FB2', btnBg: '#0A1020', btnFg: '#EEF4FA' });
---
<BaseLayout title="Website Prices Glasgow & UK | Packages from £495 | Bastian Studio" description="Clear website prices: one-page sites from £495, 5-page sites from £1,195, online shops from £2,495. Fixed quotes, no hidden costs." current="Prices">
<!-- ================= PRICES INTRO ================= -->
<section id="prices" style="position: relative; padding: 72px 0 64px; background: radial-gradient(900px 420px at 80% 0%, rgba(62,143,208,.2), transparent 70%), #0A1020">
  <div class="wrap">
    <p class="mono" style="margin: 0 0 18px; color: #9FD3F5"><a href="/" style="color: #9AA8BC; text-decoration: none">Home</a> / Prices</p>
    <h1 style="margin: 0; font-size: clamp(40px, 5.4vw, 76px); font-weight: 500; line-height: 1; letter-spacing: -.045em; max-width: 16ch">Website prices, <span class="serif" style="color: #9FD3F5">explained honestly.</span></h1>
    <p style="margin: 24px 0 32px; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.55; color: #B7C3D4; max-width: 52ch">What websites typically cost in the UK, what changes the price, what you’ll pay each month, and why hiring a professional usually costs less than doing it yourself.</p>
    <nav aria-label="On this page" style="display: flex; flex-wrap: wrap; gap: 8px">
      <a href="#diy" class="tab" style="display: inline-flex; align-items: center; color: #EEF4FA; text-decoration: none">DIY or a pro?</a>
      <a href="#pricing" class="tab" style="display: inline-flex; align-items: center; color: #EEF4FA; text-decoration: none">UK price ranges</a>
      <a href="#packages" class="tab" style="display: inline-flex; align-items: center; color: #EEF4FA; text-decoration: none">Packages</a>
      <a href="#running" class="tab" style="display: inline-flex; align-items: center; color: #EEF4FA; text-decoration: none">Running costs</a>
    </nav>
  </div>
</section>

<!-- ================= DIY vs PRO ================= -->
<section id="diy" class="light sec" style="padding: 112px 0; background: #F3F7FB; color: #0A1020">
  <div class="wrap">
    <div class="split" style="margin-bottom: 44px; align-items: end">
      <div class="split-a7">
        <p class="mono" style="margin: 0 0 18px; color: #1F6FB2">Do it yourself, or hire a pro?</p>
        <h2 class="h2">Website builders look cheap. <span class="serif" style="color: #1F6FB2">Until you count your time.</span></h2>
      </div>
      <div class="split-b5"><p class="lead">Wix and Squarespace are fine for a hobby. For a business that needs customers, here’s the honest comparison.</p></div>
    </div>
    <div class="cmp-grid" role="table" aria-label="Do it yourself compared with hiring Bastian Studio" style="box-shadow: 0 1px 0 rgba(10,16,32,.06), 0 30px 60px -40px rgba(10,16,32,.35)">
      <div class="cmp-row cmp-head" role="row">
        <div role="columnheader" class="mono" style="color: #4A5870"></div>
        <div role="columnheader" style="font-weight: 500">Do it yourself</div>
        <div role="columnheader" style="font-weight: 600; background: #0A1020; color: #EEF4FA">With Bastian Studio</div>
      </div>
      {diy.map((row) => (<Fragment>
        <div class="cmp-row" role="row">
          <div role="rowheader" class="mono" style="color: #4A5870; font-weight: 500">{row.k}</div>
          <div role="cell" style="color: #4A5870"><span class="lbl-sm" style="font-weight: 600; color: #0A1020">Do it yourself: </span>{row.diy}</div>
          <div role="cell" style="background: #F7FAFD; font-weight: 500"><span class="lbl-sm" style="font-weight: 600; color: #1F6FB2">With me: </span>{row.pro}</div>
        </div>
      </Fragment>))}
    </div>
  </div>
</section>

<!-- ================= PRICING ================= -->
<section id="pricing" class="light sec-b" style="padding: 0 0 128px; background: #F3F7FB; color: #0A1020">
  <div class="wrap">
    <div style="border-top: 1px solid rgba(10,16,32,.12); padding-top: 104px" class="split pricing-top">
      <div class="split-a7">
        <p class="mono" style="margin: 0 0 18px; color: #1F6FB2">Website prices in the UK</p>
        <h2 class="h2">How much does a website cost? <span class="serif" style="color: #1F6FB2">Straight answers.</span></h2>
      </div>
      <div class="split-b5" style="align-self: end"><p class="lead">Typical UK prices in 2026, from DIY builders to agencies. Where you land depends on the number of pages, design, features and who writes the words.</p></div>
    </div>

    <!-- range chart -->
    <div style="margin-top: 48px; border-radius: 24px; background: #FFFFFF; padding: clamp(20px, 3vw, 36px); box-shadow: 0 30px 60px -40px rgba(10,16,32,.35)">
      <div style="display: flex; flex-direction: column; gap: 0">
        {ranges.map((r) => (<Fragment>
          <div class="range-row">
            <div>
              <p style="margin: 0; font-size: 17px; font-weight: 500">{r.label}</p>
              <p style="margin: 2px 0 0; font-size: 14px; color: #4A5870">{r.note}</p>
              <p style="margin: 6px 0 0; font-size: 16px; font-weight: 600; color: #1F6FB2">{r.text}</p>
            </div>
            <div aria-hidden="true" style="position: relative; height: 24px">
              <div style="position: absolute; left: 0; right: 0; top: 11px; height: 2px; background: #E2E9F2"></div>
              <div style={`position: absolute; top: 2px; height: 20px; border-radius: 999px; background: #0A1020; left: ${r.left}; width: ${r.width}`}></div>
            </div>
          </div>
        </Fragment>))}
      </div>
      <div class="axis-row" aria-hidden="true">
        <span></span>
        <div class="mono" style="display: flex; justify-content: space-between; color: #4A5870; font-size: 11px"><span>£0</span><span class="tick-mid">£2.5k</span><span>£5k</span><span class="tick-mid">£7.5k</span><span>£10k</span><span class="tick-mid">£12.5k</span><span>£15k+</span></div>
      </div>
      <p style="margin: 18px 0 0; font-size: 13px; color: #4A5870">Indicative UK market ranges for guidance only. Every project is quoted individually.</p>
    </div>

    <!-- what affects the price -->
    <div class="split" style="margin-top: 72px; gap: 40px">
      <div class="split-a">
        <h3 style="margin: 0 0 14px; font-size: 30px; font-weight: 500; letter-spacing: -.03em">What affects the price?</h3>
        <p class="lead">Two sites with “5 pages” can be very different jobs. These are the things that move the number most.</p>
      </div>
      <ul class="split-b factors">
        <li style="padding: 16px 0; border-top: 1px solid rgba(10,16,32,.12)"><strong style="font-weight: 500">Number of pages</strong><br><span style="color: #4A5870; font-size: 15px">Each service, location or treatment page takes design and writing.</span></li>
        <li style="padding: 16px 0; border-top: 1px solid rgba(10,16,32,.12)"><strong style="font-weight: 500">Custom design vs template</strong><br><span style="color: #4A5870; font-size: 15px">Bespoke design costs more, and stands out more.</span></li>
        <li style="padding: 16px 0; border-top: 1px solid rgba(10,16,32,.12)"><strong style="font-weight: 500">Copywriting &amp; photos</strong><br><span style="color: #4A5870; font-size: 15px">Words that sell, and images that aren’t stock clichés.</span></li>
        <li style="padding: 16px 0; border-top: 1px solid rgba(10,16,32,.12)"><strong style="font-weight: 500">Features</strong><br><span style="color: #4A5870; font-size: 15px">Online booking, quote forms, galleries, payments, memberships.</span></li>
        <li style="padding: 16px 0; border-top: 1px solid rgba(10,16,32,.12)"><strong style="font-weight: 500">E-commerce</strong><br><span style="color: #4A5870; font-size: 15px">Number of products, payments, delivery rules, stock.</span></li>
        <li style="padding: 16px 0; border-top: 1px solid rgba(10,16,32,.12)"><strong style="font-weight: 500">SEO setup</strong><br><span style="color: #4A5870; font-size: 15px">Keyword research, Google Business Profile, local pages.</span></li>
      </ul>
    </div>

    <!-- packages -->
    <div id="packages" style="margin-top: 88px">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 28px">
        <h3 style="margin: 0; font-size: clamp(28px, 3vw, 40px); font-weight: 500; letter-spacing: -.03em">Website packages</h3>
        <p style="margin: 0; color: #4A5870; font-size: 15px">Starting prices. You’ll get a fixed quote in writing before any work starts. <a href="/terms" style="color: #1F6FB2">Terms &amp; conditions</a>.</p>
      </div>
      <div class="boxpad" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 28px; margin-bottom: 20px; padding: 22px 28px; border-radius: 20px; background: #FFFFFF; border: 1px solid rgba(10,16,32,.1)">
        <div style="flex: 1 1 360px; min-width: 0">
          <p style="margin: 0 0 4px; font-size: 20px; font-weight: 500">Just need one page? <span style="color: #1F6FB2">One-page website from £495</span></p>
          <p style="margin: 0; color: #4A5870; font-size: 15px">A single scrolling page with your services, contact form &amp; click-to-call, Google Business Profile and basic SEO.</p>
        </div>
        <a href="#contact" data-enquiry="Hi Sebastian, I’m interested in the One-page website (from £495). " class="btn btn-ink">Get a quote</a>
      </div>
      <div class="packs">
        {packs.map((pk) => (<Fragment>
          <div class="boxpad" style={`border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 20px; background: ${pk.bg}; color: ${pk.fg}; border: 1px solid ${pk.border}`}>
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px">
              <p style="margin: 0; font-size: 22px; font-weight: 500; letter-spacing: -.02em">{pk.name}</p>
              {pk.popular && (<Fragment><span class="mono" style="font-size: 11px; padding: 5px 10px; border-radius: 999px; background: #9FD3F5; color: #0A1020">Most popular</span></Fragment>)}
            </div>
            <p style="margin: 0; font-size: 15px; line-height: 1.5; opacity: .8">{pk.for}</p>
            <p style="margin: 0"><span style="font-size: 14px; opacity: .7">from </span><span style="font-size: 36px; font-weight: 500; letter-spacing: -.03em">{pk.price}</span></p>
            <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; flex: 1">
              {pk.inc.map((i) => (<Fragment>
                <li style="display: flex; gap: 10px; font-size: 15px; line-height: 1.4"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke={pk.tick} stroke-width="2" aria-hidden="true" style="flex: none; margin-top: 1px"><path d="M4 10.5l4 4 8-9"></path></svg>{i}</li>
              </Fragment>))}
            </ul>
            <a href="#contact" data-enquiry={pk.msg} class="btn" style={`background: ${pk.btnBg}; color: ${pk.btnFg}`}>Get a quote</a>
          </div>
        </Fragment>))}
      </div>
    </div>

    <!-- included with every website -->
    <div style="margin-top: 56px">
      <h3 style="margin: 0 0 18px; font-size: clamp(24px, 2.4vw, 30px); font-weight: 500; letter-spacing: -.03em">Included with every website</h3>
      <ul class="incl" style="list-style: none; margin: 0; padding: 0"><li style="display: flex; align-items: center; gap: 10px; padding: 14px 0; border-top: 1px solid rgba(10,16,32,.1); font-size: 16px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#1F6FB2" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M4 10.5l4 4 8-9"></path></svg>Secure HTTPS</li><li style="display: flex; align-items: center; gap: 10px; padding: 14px 0; border-top: 1px solid rgba(10,16,32,.1); font-size: 16px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#1F6FB2" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M4 10.5l4 4 8-9"></path></svg>Mobile-friendly design</li><li style="display: flex; align-items: center; gap: 10px; padding: 14px 0; border-top: 1px solid rgba(10,16,32,.1); font-size: 16px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#1F6FB2" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M4 10.5l4 4 8-9"></path></svg>Fast loading</li><li style="display: flex; align-items: center; gap: 10px; padding: 14px 0; border-top: 1px solid rgba(10,16,32,.1); font-size: 16px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#1F6FB2" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M4 10.5l4 4 8-9"></path></svg>Contact form &amp; click-to-call</li><li style="display: flex; align-items: center; gap: 10px; padding: 14px 0; border-top: 1px solid rgba(10,16,32,.1); font-size: 16px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#1F6FB2" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M4 10.5l4 4 8-9"></path></svg>Google Business Profile setup</li><li style="display: flex; align-items: center; gap: 10px; padding: 14px 0; border-top: 1px solid rgba(10,16,32,.1); font-size: 16px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#1F6FB2" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M4 10.5l4 4 8-9"></path></svg>Basic SEO</li><li style="display: flex; align-items: center; gap: 10px; padding: 14px 0; border-top: 1px solid rgba(10,16,32,.1); font-size: 16px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#1F6FB2" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M4 10.5l4 4 8-9"></path></svg>Privacy policy &amp; cookie-free setup</li><li style="display: flex; align-items: center; gap: 10px; padding: 14px 0; border-top: 1px solid rgba(10,16,32,.1); font-size: 16px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#1F6FB2" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M4 10.5l4 4 8-9"></path></svg>You own everything</li></ul>
    </div>

    <!-- running costs -->
    <div id="running" class="split" style="margin-top: 88px; gap: 40px">
      <div class="split-a">
        <h3 style="margin: 0 0 14px; font-size: 30px; font-weight: 500; letter-spacing: -.03em">What else should I budget for?</h3>
        <p class="lead">Less than you might think. There’s only one running cost. Everything else is optional.</p>
      </div>
      <div class="split-b" style="display: flex; flex-direction: column; gap: 16px">
        <div class="boxpad" style="border-radius: 20px; padding: 28px; background: #0A1020; color: #EEF4FA">
          <p class="mono" style="margin: 0 0 10px; color: #9FD3F5">The only running cost</p>
          <p style="margin: 0 0 6px; font-size: clamp(24px, 2.4vw, 30px); font-weight: 500; letter-spacing: -.02em">Domain &amp; hosting, <span class="serif" style="color: #9FD3F5; font-size: 1.1em">from around £20 a year</span></p>
          <p style="margin: 0; color: #B7C3D4; font-size: 15px; line-height: 1.5">Your web address and a fast, secure home for your site. I set it all up for you. Simple sites sit at the low end.</p>
        </div>
        <div class="two-col" style="gap: 16px">
          <div class="boxpad" style="border-radius: 20px; padding: 24px; background: #FFFFFF; border: 1px solid rgba(10,16,32,.1)">
            <p class="mono" style="margin: 0 0 14px; color: #1F6FB2">Included with every website</p>
            <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px"><li style="display: flex; align-items: center; gap: 10px; font-size: 16px"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="#1F6FB2" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M4 10.5l4 4 8-9"></path></svg>SEO setup, Google-ready from day one</li><li style="display: flex; align-items: center; gap: 10px; font-size: 16px"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="#1F6FB2" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M4 10.5l4 4 8-9"></path></svg>Google Business Profile setup</li><li style="display: flex; align-items: center; gap: 10px; font-size: 16px"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="#1F6FB2" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M4 10.5l4 4 8-9"></path></svg>Mobile-friendly, fast &amp; secure</li></ul>
          </div>
          <div class="boxpad" style="border-radius: 20px; padding: 24px; background: #FFFFFF; border: 1px solid rgba(10,16,32,.1)">
            <p class="mono" style="margin: 0 0 14px; color: #4A5870">Optional, only if you want them</p>
            <ul style="list-style: none; margin: 0 0 14px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px"><li style="font-size: 15px; padding: 8px 14px; border-radius: 999px; border: 1px solid rgba(10,16,32,.15); color: #0A1020">Maintenance &amp; support</li><li style="font-size: 15px; padding: 8px 14px; border-radius: 999px; border: 1px solid rgba(10,16,32,.15); color: #0A1020">Ongoing SEO</li><li style="font-size: 15px; padding: 8px 14px; border-radius: 999px; border: 1px solid rgba(10,16,32,.15); color: #0A1020">Google Ads</li><li style="font-size: 15px; padding: 8px 14px; border-radius: 999px; border: 1px solid rgba(10,16,32,.15); color: #0A1020">Social media graphics</li></ul>
            <p style="margin: 0; font-size: 14px; color: #4A5870">Priced to suit your business. <a href="#contact" style="color: #1F6FB2">Ask for a quote</a>.</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<ContactSection />

</BaseLayout>
