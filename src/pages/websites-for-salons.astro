---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import ContactSection from '../components/ContactSection.astro';
import { salonFaqs } from '../data/faqs';
---
<BaseLayout title="Websites for Salons & Beauty Businesses in Glasgow | Bastian Studio" description="Salon and beauty websites with online booking, deposits and automatic reminders. Fill your diary without answering the phone mid-treatment.">
<section id="top" class="hero-pad" style="position: relative; padding: 80px 0 88px; background: radial-gradient(900px 460px at 80% 0%, rgba(62,143,208,.22), transparent 70%), #0A1020">
  <div class="wrap">
    <p class="mono" style="margin: 0 0 20px; color: #9FD3F5"><a href="/" style="color: #9AA8BC; text-decoration: none">Home</a> / <a href="/#why" style="color: #9AA8BC; text-decoration: none">Who I help</a> / Salons & beauty</p>
    <h1 style="margin: 0; font-size: clamp(40px, 5.4vw, 76px); font-weight: 500; line-height: 1; letter-spacing: -.045em; max-width: 18ch">Websites for salons &amp; beauty businesses <span class="serif" style="color: #9FD3F5">in Glasgow.</span></h1>
    <p style="margin: 24px 0 32px; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.55; color: #B7C3D4; max-width: 54ch">For nail techs, hair salons, lash and brow artists, barbers and beauty clinics. A beautiful website with online booking that fills your diary without answering the phone mid-treatment.</p>
    <div style="display: flex; flex-wrap: wrap; gap: 12px">
      <a href="#contact" class="btn btn-ice">Get a free quote
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 9h12M10 4l5 5-5 5"></path></svg>
      </a>
      <a href="/prices" class="btn btn-ghost">See prices</a>
    </div>
    <ul style="list-style: none; margin: 32px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 26px; font-size: 15px; color: #C9D4E3"><li style="display: flex; align-items: center; gap: 8px"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#9FD3F5" stroke-width="1.8" aria-hidden="true"><path d="M3 8.5l3 3 7-7"></path></svg>Online booking & deposits</li><li style="display: flex; align-items: center; gap: 8px"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#9FD3F5" stroke-width="1.8" aria-hidden="true"><path d="M3 8.5l3 3 7-7"></path></svg>Automatic reminders</li><li style="display: flex; align-items: center; gap: 8px"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#9FD3F5" stroke-width="1.8" aria-hidden="true"><path d="M3 8.5l3 3 7-7"></path></svg>Found on Google Maps</li></ul>
  </div>
</section>

<section class="sec" style="padding: 104px 0; background: #0A1020; border-top: 1px solid rgba(159,211,245,.08)">
  <div class="wrap">
    <div class="split" style="margin-bottom: 40px">
      <div class="split-a7">
        <p class="mono" style="margin: 0 0 18px; color: #9FD3F5">Sound familiar?</p>
        <h2 class="h2">The problems every busy salon <span class="serif" style="color: #9FD3F5">knows.</span></h2>
      </div>
      
    </div>
    <div class="why why-2"><div class="why-item"><p class="mono" style="margin: 0 0 12px; color: #9FD3F5">01</p><h3 style="margin: 0 0 10px; font-size: 21px; font-weight: 500; letter-spacing: -.02em">Missed calls mid-treatment</h3><p style="margin: 0; color: #9AA8BC; font-size: 16px; line-height: 1.55">You can’t answer the phone with a client in the chair, and missed calls become someone else’s bookings.</p></div><div class="why-item"><p class="mono" style="margin: 0 0 12px; color: #9FD3F5">02</p><h3 style="margin: 0 0 10px; font-size: 21px; font-weight: 500; letter-spacing: -.02em">Bookings lost in DMs</h3><p style="margin: 0; color: #9AA8BC; font-size: 16px; line-height: 1.55">Instagram messages, texts and voicemails. Keeping track of it all takes hours.</p></div><div class="why-item"><p class="mono" style="margin: 0 0 12px; color: #9FD3F5">03</p><h3 style="margin: 0 0 10px; font-size: 21px; font-weight: 500; letter-spacing: -.02em">No-shows and late cancellations</h3><p style="margin: 0; color: #9AA8BC; font-size: 16px; line-height: 1.55">Empty slots cost you money, and chasing people is awkward.</p></div><div class="why-item"><p class="mono" style="margin: 0 0 12px; color: #9FD3F5">04</p><h3 style="margin: 0 0 10px; font-size: 21px; font-weight: 500; letter-spacing: -.02em">Hard to find on Google</h3><p style="margin: 0; color: #9AA8BC; font-size: 16px; line-height: 1.55">People search “nails near me” or “lash extensions Glasgow” and find your competitors first.</p></div></div>
  </div>
</section>

<section class="sec" style="padding: 104px 0; background: #0C1426; border-top: 1px solid rgba(159,211,245,.08)">
  <div class="wrap">
    <div class="split" style="margin-bottom: 40px">
      <div class="split-a7">
        <p class="mono" style="margin: 0 0 18px; color: #9FD3F5">How I help</p>
        <h2 class="h2">A website that takes bookings <span class="serif" style="color: #9FD3F5">while you work.</span></h2>
      </div>
      <div class="split-b5" style="align-self: end"><p class="lead">Everything joined up: your website, booking system, reminders and Google profile.</p></div>
    </div>
    <ul class="factors" style="grid-template-columns: repeat(2, minmax(0, 1fr))"><li style="padding: 18px 0; border-top: 1px solid rgba(159,211,245,.16); display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#9FD3F5" stroke-width="1.8" aria-hidden="true" style="margin-top: 2px"><path d="M4 10.5l4 4 8-9"></path></svg><span><strong style="display: block; font-weight: 500; font-size: 17px; margin-bottom: 4px">Online booking, 24/7</strong><span style="color: #9AA8BC; font-size: 15px; line-height: 1.5">Clients book and pay deposits themselves, any time of day.</span></span></li><li style="padding: 18px 0; border-top: 1px solid rgba(159,211,245,.16); display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#9FD3F5" stroke-width="1.8" aria-hidden="true" style="margin-top: 2px"><path d="M4 10.5l4 4 8-9"></path></svg><span><strong style="display: block; font-weight: 500; font-size: 17px; margin-bottom: 4px">Automatic reminders</strong><span style="color: #9AA8BC; font-size: 15px; line-height: 1.5">Text and email reminders cut no-shows. No chasing.</span></span></li><li style="padding: 18px 0; border-top: 1px solid rgba(159,211,245,.16); display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#9FD3F5" stroke-width="1.8" aria-hidden="true" style="margin-top: 2px"><path d="M4 10.5l4 4 8-9"></path></svg><span><strong style="display: block; font-weight: 500; font-size: 17px; margin-bottom: 4px">A gallery that sells</strong><span style="color: #9AA8BC; font-size: 15px; line-height: 1.5">Show off your work with before-and-afters and a clear price list.</span></span></li><li style="padding: 18px 0; border-top: 1px solid rgba(159,211,245,.16); display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#9FD3F5" stroke-width="1.8" aria-hidden="true" style="margin-top: 2px"><path d="M4 10.5l4 4 8-9"></path></svg><span><strong style="display: block; font-weight: 500; font-size: 17px; margin-bottom: 4px">Found on Google</strong><span style="color: #9AA8BC; font-size: 15px; line-height: 1.5">Rank for searches like “nails near me” and “salon Glasgow”.</span></span></li><li style="padding: 18px 0; border-top: 1px solid rgba(159,211,245,.16); display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#9FD3F5" stroke-width="1.8" aria-hidden="true" style="margin-top: 2px"><path d="M4 10.5l4 4 8-9"></path></svg><span><strong style="display: block; font-weight: 500; font-size: 17px; margin-bottom: 4px">Matching social graphics</strong><span style="color: #9AA8BC; font-size: 15px; line-height: 1.5">On-brand templates for offers and new treatments.</span></span></li><li style="padding: 18px 0; border-top: 1px solid rgba(159,211,245,.16); display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#9FD3F5" stroke-width="1.8" aria-hidden="true" style="margin-top: 2px"><path d="M4 10.5l4 4 8-9"></path></svg><span><strong style="display: block; font-weight: 500; font-size: 17px; margin-bottom: 4px">Easy to update</strong><span style="color: #9AA8BC; font-size: 15px; line-height: 1.5">Change prices and treatments yourself in minutes.</span></span></li></ul>
  </div>
</section>

<section class="light sec" style="padding: 104px 0; color: #0A1020; background: #F3F7FB; border-top: 1px solid rgba(159,211,245,.08)">
  <div class="wrap">
    <div class="split" style="margin-bottom: 40px">
      <div class="split-a7">
        <p class="mono" style="margin: 0 0 18px; color: #1F6FB2">Recommended</p>
        <h2 class="h2">The usual setup <span class="serif" style="color: #1F6FB2">for salons.</span></h2>
      </div>
      <div class="split-b5" style="align-self: end"><p class="lead">A starting point. I’ll adjust it to your business on a free call.</p></div>
    </div>
    <div class="two-col" style="gap: 20px">
      <div class="boxpad" style="border-radius: 24px; padding: 32px; background: #FFFFFF; border: 1px solid rgba(10,16,32,.1)">
        <p style="margin: 0 0 6px; font-size: 22px; font-weight: 500">Business package + booking</p>
        <p style="margin: 0 0 18px; color: #4A5870">from <strong style="color: #0A1020; font-size: 22px">£1,995</strong></p>
        <ul class="factors" style="grid-template-columns: repeat(1, minmax(0, 1fr))"><li style="padding: 18px 0; border-top: 1px solid rgba(10,16,32,.1); display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#1F6FB2" stroke-width="1.8" aria-hidden="true" style="margin-top: 2px"><path d="M4 10.5l4 4 8-9"></path></svg><span><strong style="display: block; font-weight: 500; font-size: 17px; margin-bottom: 4px">Up to 10 pages</strong><span style="color: #4A5870; font-size: 15px; line-height: 1.5">Treatments, prices, gallery, about, contact.</span></span></li><li style="padding: 18px 0; border-top: 1px solid rgba(10,16,32,.1); display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#1F6FB2" stroke-width="1.8" aria-hidden="true" style="margin-top: 2px"><path d="M4 10.5l4 4 8-9"></path></svg><span><strong style="display: block; font-weight: 500; font-size: 17px; margin-bottom: 4px">Online booking</strong><span style="color: #4A5870; font-size: 15px; line-height: 1.5">Linked to Fresha, Booksy or your own system.</span></span></li><li style="padding: 18px 0; border-top: 1px solid rgba(10,16,32,.1); display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#1F6FB2" stroke-width="1.8" aria-hidden="true" style="margin-top: 2px"><path d="M4 10.5l4 4 8-9"></path></svg><span><strong style="display: block; font-weight: 500; font-size: 17px; margin-bottom: 4px">Google setup</strong><span style="color: #4A5870; font-size: 15px; line-height: 1.5">Business Profile and local SEO.</span></span></li></ul>
      </div>
      <div class="boxpad" style="border-radius: 24px; padding: 32px; background: #0A1020; color: #EEF4FA">
        <p style="margin: 0 0 6px; font-size: 22px; font-weight: 500">Optional extras</p>
        <p style="margin: 0 0 18px; color: #9AA8BC">Add any time</p>
        <ul class="factors" style="grid-template-columns: repeat(1, minmax(0, 1fr))"><li style="padding: 18px 0; border-top: 1px solid rgba(159,211,245,.16); display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#9FD3F5" stroke-width="1.8" aria-hidden="true" style="margin-top: 2px"><path d="M4 10.5l4 4 8-9"></path></svg><span><strong style="display: block; font-weight: 500; font-size: 17px; margin-bottom: 4px">Automation</strong><span style="color: #9AA8BC; font-size: 15px; line-height: 1.5">Reminders, review requests and rebooking messages.</span></span></li><li style="padding: 18px 0; border-top: 1px solid rgba(159,211,245,.16); display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#9FD3F5" stroke-width="1.8" aria-hidden="true" style="margin-top: 2px"><path d="M4 10.5l4 4 8-9"></path></svg><span><strong style="display: block; font-weight: 500; font-size: 17px; margin-bottom: 4px">Social media graphics</strong><span style="color: #9AA8BC; font-size: 15px; line-height: 1.5">Templates for offers and new looks.</span></span></li><li style="padding: 18px 0; border-top: 1px solid rgba(159,211,245,.16); display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#9FD3F5" stroke-width="1.8" aria-hidden="true" style="margin-top: 2px"><path d="M4 10.5l4 4 8-9"></path></svg><span><strong style="display: block; font-weight: 500; font-size: 17px; margin-bottom: 4px">Google Ads</strong><span style="color: #9AA8BC; font-size: 15px; line-height: 1.5">Fill quiet days fast.</span></span></li></ul>
      </div>
    </div>
  </div>
</section>

<section id="faq" class="sec" style="padding: 104px 0; background: #0C1426; border-top: 1px solid rgba(159,211,245,.1)">
  <div class="wrap split">
    <div class="split-a">
      <p class="mono" style="margin: 0 0 18px; color: #9FD3F5">FAQ</p>
      <h2 class="h2">Salon owners often ask.</h2>
    </div>
    <Faq items={salonFaqs} id="faq-salon" />
  </div>
</section>

<ContactSection />

</BaseLayout>
